const requestParams = {};

requestParams.encoding = data.encoding;

if(data.googleAdsCustomerListDestinations || data.dvCustomerListDestinations) {
  requestParams.destinations = [];
}

if(data.googleAdsCustomerListDestinations) {
  data.googleAdsCustomerListDestinations.forEach((googleAdsCustomerListDestination) => {
     requestParams.destinations.push({
       operatingAccount: {
         accountType: 'GOOGLE_ADS',
         accountId: googleAdsCustomerListDestination.operatingCustomerId.indexOf('-') != -1 ? googleAdsCustomerListDestination.operatingCustomerId.replace(createRegex('-', 'g'), '') : googleAdsCustomerListDestination.operatingCustomerId 
       },
       loginAccount: {
         accountType: 'GOOGLE_ADS',
         accountId: googleAdsCustomerListDestination.customerId.indexOf('-') != -1 ? googleAdsCustomerListDestination.customerId.replace(createRegex('-', 'g'), '') : googleAdsCustomerListDestination.customerId
       },
       productDestinationId: googleAdsCustomerListDestination.audienceId
     });
  });
}


if(data.dvCustomerListDestinations) {
  data.dvCustomerListDestinations.forEach((dvCustomerListDestination) => {
     requestParams.destinations.push({
       operatingAccount: {
         accountType: 'DISPLAY_VIDEO_ADVERTISER',
         accountId: dvCustomerListDestination.operatingCustomerId.indexOf('-') != -1 ? dvCustomerListDestination.operatingCustomerId.replace(createRegex('-', 'g'), '') : dvCustomerListDestination.operatingCustomerId 
       },
       loginAccount: {
         accountType: 'DISPLAY_VIDEO_ADVERTISER',
         accountId: dvCustomerListDestination.customerId.indexOf('-') != -1 ? dvCustomerListDestination.customerId.replace(createRegex('-', 'g'), '') : dvCustomerListDestination.customerId
       },
       productDestinationId: dvCustomerListDestination.audienceId
     });
  });
}
/* ============================================================
   TERMS OF SERVICE
============================================================ */


const normalizeTermsOfService = (value) => {
  let result = 'TERMS_OF_SERVICE_STATUS_UNSPECIFIED';

  if (value === 'ACCEPTED' || value === 'REJECTED') {
    result = value;
  } else {
    if (typeof value === 'string') {
      value = value.toLowerCase();
    }

    if (value === true || value === 'true' || value === 'granted' || value === 'accepted') {
      result = 'ACCEPTED';
    } else if (value === false || value === 'false' || value === 'denied' || value === 'rejected') {
      result = 'REJECTED';
    }
  }

  return result;
};

if(data.customerListAction == 'ingest') {

  requestParams.termsOfService = {};
  requestParams.termsOfService.customerMatchTermsOfServiceStatus = normalizeTermsOfService(data.termsOfService !== 'read_from_event_data' ? data.termsOfService :   eventData.terms_of_service);

}

/* ============================================================
   CONSENT BLOCK
============================================================ */

const normalizeConsent = (value) => {
  let result = 'CONSENT_STATUS_UNSPECIFIED';

  if (value === 'CONSENT_GRANTED' || value === 'CONSENT_DENIED') {
    result = value;
  } else {
    if (typeof value === 'string') {
      value = value.toLowerCase();
    }

    if (value === true || value === 'true' || value === 'granted') {
      result = 'CONSENT_GRANTED';
    } else if (value === false || value === 'false' || value === 'denied') {
      result = 'CONSENT_DENIED';
    }
  }

  return result;
};

if(data.customerListAction == 'ingest') {

  const consent = eventData.consent || {};

  requestParams.consent = {
    adUserData: normalizeConsent(
      data.requestAdUserDataConsent !== 'read_from_event_data' ? data.requestAdUserDataConsent : consent.ad_user_data
    ),
    adPersonalization: normalizeConsent(
      data.requestAdPersonalizationConsent !== 'read_from_event_data' ? data.requestAdPersonalizationConsent : consent.ad_personalization
    )
  };
  
}

/* ============================================================
   SHARED SETTINGS
============================================================ */

const ipAddressAllowed = data.ipAddressAllowed === true || data.ipAddressAllowed === "true" || data.ipAddressAllowed === "granted";
const hasDvDestination = data.dvCustomerListDestinations && data.dvCustomerListDestinations.length > 0;
const batchMode = data.enableBatchMode;

/* ============================================================
   AUDIENCE MEMBER BUILDER
============================================================ */

function buildAudienceMember(member) {
  const audienceMember = {};
  const userIdentifiers = [];

  /* Email(s) */
  const emailMapped = member.sha256_email_address || member.email_address || member.email;
  if (emailMapped) {
    const emailList = getType(emailMapped) === 'array' ? emailMapped : [emailMapped];
    emailList.forEach(email => {
      if (!email) return;
      const normalizedEmail = isAlreadyHashed(email) ? email : normalizeEmail(email);
      if (normalizedEmail) {
        const hashedEmail = hashData(normalizedEmail);
        userIdentifiers.push({emailAddress: hashedEmail});
      }
    });
  }

  /* Phone(s) */
  const phoneMapped = member.sha256_phone_number || member.phone_number || member.phone;
  if (phoneMapped) {
    const phoneList = getType(phoneMapped) === 'array' ? phoneMapped : [phoneMapped];
    phoneList.forEach(phone => {
      if (!phone) return;
      const normalizedPhone = isAlreadyHashed(phone) ? phone : normalizePhone(phone);
      if (normalizedPhone) {
        const hashedPhone = hashData(normalizedPhone);
        userIdentifiers.push({phoneNumber: hashedPhone});
      }
    });
  }

  /* Address */
  const addressData = member.address != null ? (member.address[0] != null ? member.address[0] : member.address) : {};
  const addressMapped = {};

  addressMapped.givenName = addressData.sha256_first_name || addressData.first_name;
  if (addressMapped.givenName) addressMapped.givenName = hashData(addressMapped.givenName);

  addressMapped.familyName = addressData.sha256_last_name || addressData.last_name;
  if (addressMapped.familyName) addressMapped.familyName = hashData(addressMapped.familyName);

  addressMapped.regionCode = addressData.country;
  addressMapped.postalCode = addressData.postal_code;

  if (addressMapped.givenName && addressMapped.familyName && addressMapped.regionCode && addressMapped.postalCode) {
    userIdentifiers.push({address: addressMapped});
  }
  
  const memberConsent = buildMemberConsent(member.consent);

  if (userIdentifiers.length > 0) {
    audienceMember.compositeData = {userData: {userIdentifiers: userIdentifiers}};
    
    const ipMapped = member.ip_override || member.ip || member.ip_address;
    if (ipAddressAllowed && ipMapped && !hasDvDestination) {
      const ipList = getType(ipMapped) === 'array' ? ipMapped : [ipMapped];
      const ipData = [];
      ipList.forEach(ip => {
        if (ip) ipData.push({ipAddress: ip});
      });
      if (ipData.length > 0) {
        audienceMember.compositeData.ipData = ipData;
      }
    }

    if (memberConsent) audienceMember.consent = memberConsent;

    return audienceMember;
  }

  const userId = member.user_id || member.userId;
  if (userId) {
    audienceMember.userIdData = {userId: userId};
    return audienceMember;
  }

  const mobileMapped = member.mobile_id;
  if (mobileMapped) {
    const mobileList = getType(mobileMapped) === 'array' ? mobileMapped : [mobileMapped];
    const mobileIds = [];
    mobileList.forEach(mobileId => {
      if (mobileId && mobileIds.length < 10) mobileIds.push(mobileId);
    });
    if (mobileIds.length > 0) {
      audienceMember.mobileData = {mobileIds: mobileIds};
      return audienceMember;
    }
  }
  
  return undefined;
}

function buildMemberConsent(consent) {
  if (!consent || getType(consent) !== 'object') return undefined;

  if (consent.ad_user_data == null && consent.ad_personalization == null) return undefined;

  const result = {};
  if (consent.ad_user_data != null) {
    result.adUserData = normalizeConsent(consent.ad_user_data);
  }
  if (consent.ad_personalization != null) {
    result.adPersonalization = normalizeConsent(consent.ad_personalization);
  }
  return result;
}

/* ============================================================
   BUILD AUDIENCE MEMBERS
============================================================ */

requestParams.audienceMembers = [];

if (batchMode) {

  /* ---------- BULK MODE: one AudienceMember per array entry ---------- */

  const membersList = data.usersBatch || eventData.members;

  if (membersList && getType(membersList) == 'array' && membersList.length > 0) {
    const maxMembers = membersList.length > 10000 ? 10000 : membersList.length;

    for (let i = 0; i < maxMembers; i++) {
      const item = membersList[i];
      if (!item || getType(item) != 'object') continue;

      const member = buildAudienceMember(item);
      if (member) {
        requestParams.audienceMembers.push(member);
      }
    }
  }

} else {

  /* ---------- SINGLE MODE: UI overrides + event data fallbacks ---------- */

  const eventUserData = eventData.user_data || {};
  const eventAddress = (eventUserData.address != null) ? (eventUserData.address[0] != null ? eventUserData.address[0] : eventUserData.address) : {};

  const singleMember = {
    email: data.email || eventUserData.sha256_email_address || eventUserData.email_address || eventUserData.email,
    phone: data.phone || eventUserData.sha256_phone_number || eventUserData.phone_number || eventUserData.phone,
    user_id: data.userId || eventData.user_id || eventUserData.user_id,
    ip_override: eventData.ip_override || eventData.ip || eventData.ip_address,
    address: {
      first_name: data.givenName || eventAddress.sha256_first_name || eventAddress.first_name,
      last_name: data.familyName || eventAddress.sha256_last_name || eventAddress.last_name,
      country: data.regionCode || eventAddress.country,
      postal_code: data.postalCode || eventAddress.postal_code
    }
  };

  /* Mobile IDs: event device ID first, then UI override (lowest priority in the builder) */
  if (eventData['x-ga-resettable_device_id']) {
    singleMember.mobile_id = eventData['x-ga-resettable_device_id'];
  } else if (data.mobileIds && getType(data.mobileIds) == 'array' && data.mobileIds.length > 0) {
    singleMember.mobile_id = data.mobileIds;
  }

  const audienceMember = buildAudienceMember(singleMember);
  if (audienceMember) {
    requestParams.audienceMembers.push(audienceMember);
  }

}

/* ============================================================
   FINAL REQUEST
============================================================ */

if (requestParams.audienceMembers.length === 0) {
  return data.gtmOnFailure();
}

requestParams.validateOnly = data.validateOnly === undefined || data.validateOnly === true || data.validateOnly === "true";

const auth = getGoogleAuth({
  scopes: [
    'https://www.googleapis.com/auth/datamanager'
  ]
});

sendHttpRequest(
  apiEndpoint,
  {
    headers: { 'Content-Type': 'application/json' },
    method: 'POST',
    authorization: auth
  },
  JSON.stringify(requestParams)
).then((result) => {
  if (result.statusCode >= 200 && result.statusCode < 300) {
    data.gtmOnSuccess();
  } else {
    data.gtmOnFailure();
  }
}).catch(() => data.gtmOnFailure());

/* ============================================================
   UTILITIES
============================================================ */

function isAlreadyHashed(input){
  return input && (input.toString().match('^[A-Fa-f0-9]{64}$') != null);
}

function hashData(input){
  if(input == null || isAlreadyHashed(input)){
    return input;
  }
  return sha256Sync(input.toString().trim().toLowerCase(), {outputEncoding: data.encoding.toLowerCase()});
}

function stripWhitespace(value) {
  return value.split(' ').join('').split('\t').join('');
}

function normalizeEmail(email) {
  if (getType(email) !== 'string') return email;
  let e = stripWhitespace(email).toLowerCase();

  const atIndex = e.lastIndexOf('@');
  if (atIndex === -1) return e;

  let local = e.substring(0, atIndex);
  const domain = e.substring(atIndex + 1);

  if (domain === 'gmail.com' || domain === 'googlemail.com') {
    local = local.split('.').join('');
    local = local.split('+')[0];
  }

  return local + '@' + domain;
}

function normalizePhone(phone) {
  if (getType(phone) !== 'string') return phone;
  let p = phone.trim();

  p = p.split(' ').join('')
       .split('-').join('')
       .split('(').join('')
       .split(')').join('')
       .split('.').join('')
       .split('/').join('');

  if (p.indexOf('00') === 0) {
    p = '+' + p.substring(2);
  }

  if (p.indexOf('+') !== 0) return undefined;
  const digits = '0123456789';
  for (let i = 1; i < p.length; i++) {
    if (digits.indexOf(p[i]) === -1) return undefined;
  }

  return p;
}


